@model NMCNPM.Models.NhanVien

@{
    ViewData["Title"] = "Chi tiết nhân viên";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0"><i class="bi bi-person-lines-fill me-2"></i>Thông tin chi tiết nhân viên</h3>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-chevron-left me-1"></i> Quay lại</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary bg-opacity-10 py-3">
            <span class="fw-bold text-primary"><i class="bi bi-card-heading me-1"></i> Hồ sơ nhân viên: @Model.STenNV (@Model.SMaNV)</span>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-4 text-center border-end pe-4">
                    <div class="mb-3">
                        <i class="bi bi-person-circle display-1 text-secondary"></i>
                    </div>
                    <h5 class="fw-bold text-dark">@Model.STenNV</h5>
                    <p class="text-muted small mb-2">Mã NV: @Model.SMaNV</p>
                    <span class="badge bg-success px-3 py-2">@Model.STrangThai</span>
                </div>
                <div class="col-md-8 ps-4">
                    <table class="table table-borderless align-middle">
                        <tbody>
                            <tr><th width="30%" class="text-muted">Mã nhân viên:</th><td class="fw-bold">@Model.SMaNV</td></tr>
                            <tr><th class="text-muted">Họ và tên:</th><td class="fw-bold text-primary">@Model.STenNV</td></tr>
                            <tr><th class="text-muted">Ngày sinh:</th><td>@(Model.DNgaySinh.HasValue ? Model.DNgaySinh.Value.ToString("dd/MM/yyyy") : "")</td></tr>
                            <tr><th class="text-muted">CCCD:</th><td>@Model.SCCCD</td></tr>
                            <tr><th class="text-muted">Giới tính:</th><td>@Model.SGioiTinh</td></tr>
                            <tr><th class="text-muted">Số điện thoại:</th><td>@Model.SSDT</td></tr>
                            <tr><th class="text-muted">Email:</th><td>@Model.SEmail</td></tr>
                            <tr><th class="text-muted">Địa chỉ:</th><td>@Model.SDiaChi</td></tr>
                            <tr><th class="text-muted">Phòng ban:</th><td class="fw-bold text-dark">@ViewBag.TenPB</td></tr>
                            <tr><th class="text-muted">Chức vụ:</th><td class="fw-bold text-dark">@ViewBag.TenCV</td></tr>
                            <tr><th class="text-muted">Lương cơ bản:</th><td class="fw-bold text-success">@(Model.FLuongcb.ToString("N0") + " VNĐ")</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white text-end py-3">
            <a asp-action="Edit" asp-route-id="@Model.SMaNV" class="btn btn-primary px-4"><i class="bi bi-pencil me-1"></i> Chỉnh sửa</a>
        </div>
    </div>
</div>