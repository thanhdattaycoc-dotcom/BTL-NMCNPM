@model NMCNPM.Models.NhanVien

@{
    ViewData["Title"] = "Thêm nhân viên mới";
}

<div class="container-fluid px-0">
    <!-- Tiêu đề trang -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0"><i class="bi bi-person-plus-fill me-2"></i>Thêm nhân viên mới</h3>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <span class="fw-bold text-secondary"><i class="bi bi-info-circle me-1"></i> Thông tin nhân viên</span>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="col-md-4">
                    <label asp-for="SMaNV" class="form-label fw-semibold">Mã nhân viên (*)</label>
                    <input asp-for="SMaNV" class="form-control" placeholder="Nhập mã nhân viên..." required />
                    <span asp-validation-for="SMaNV" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="STenNV" class="form-label fw-semibold">Họ và tên (*)</label>
                    <input asp-for="STenNV" class="form-control" placeholder="Nhập họ và tên..." required />
                    <span asp-validation-for="STenNV" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="DNgaySinh" class="form-label fw-semibold">Ngày sinh (*)</label>
                    <input asp-for="DNgaySinh" type="date" class="form-control" required />
                    <span asp-validation-for="DNgaySinh" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">CCCD (*)</label>
                    <input type="text" class="form-control" placeholder="Nhập số CCCD..." required />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold d-block">Giới tính (*)</label>
                    <div class="mt-2">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="SGioiTinh" id="nam" value="Nam" checked>
                            <label class="form-check-label" for="nam">Nam</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="SGioiTinh" id="nu" value="Nữ">
                            <label class="form-check-label" for="nu">Nữ</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="SGioiTinh" id="khac" value="Khác">
                            <label class="form-check-label" for="khac">Khác</label>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <label asp-for="SSDT" class="form-label fw-semibold">Số điện thoại (*)</label>
                    <input asp-for="SSDT" class="form-control" placeholder="Nhập số điện thoại..." required />
                    <span asp-validation-for="SSDT" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SEmail" class="form-label fw-semibold">Email (*)</label>
                    <input asp-for="SEmail" type="email" class="form-control" placeholder="Nhập email..." required />
                    <span asp-validation-for="SEmail" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Địa chỉ (*)</label>
                    <input type="text" class="form-control" placeholder="Nhập địa chỉ..." />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Lương cơ bản (*)</label>
                    <div class="input-group">
                        <input type="number" class="form-control" placeholder="Nhập lương cơ bản..." />
                        <span class="input-group-text">VNĐ</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Ngày vào làm (*)</label>
                    <input type="date" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Phòng ban (*)</label>
                    <select asp-for="FK_sMaPB" class="form-select" asp-items="ViewBag.PhongBans" required>
                        <option value="">-- Chọn phòng ban --</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Chức vụ (*)</label>
                    <select asp-for="FK_sMaCV" class="form-select" asp-items="ViewBag.ChucVus" required>
                        <option value="">-- Chọn chức vụ --</option>
                    </select>
                </div>

                <div class="col-12 mt-4 text-center">
                    <button type="submit" class="btn btn-primary px-5 py-2 me-2"><i class="bi bi-plus-circle me-1"></i> Thêm mới</button>
                    <button type="reset" class="btn btn-outline-secondary px-4 py-2"><i class="bi bi-arrow-clockwise me-1"></i> Làm mới</button>
                </div>
            </form>
        </div>
    </div>
</div>