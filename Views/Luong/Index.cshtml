azor
@model NMCNPM.Controllers.LuongIndexViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Quản lý lương";
    ViewData["Crumb"] = "Quản lý tính lương";
    var vi = new CultureInfo("vi-VN");
    var trangThai = Model.SoBanGhi == 0 ? ("Chưa chốt", "bg-secondary")
                  : Model.DaChotXong ? ("Đã chốt xong", "bg-success")
                  : ("Chốt một phần", "bg-warning text-dark");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h4 class="mb-0 text-primary"><i class="bi bi-calculator me-2"></i>Quản lý &amp; Tính lương nhân viên</h4>
    <div class="d-flex gap-2">
        <a class="btn btn-warning text-white" asp-action="ChotKy" asp-route-ky="@Model.Ky">
            <i class="bi bi-check-circle me-1"></i>Chốt bảng lương
        </a>
        <a class="btn btn-primary" asp-action="BangLuong" asp-route-ky="@Model.Ky">
            <i class="bi bi-table me-1"></i>Xem bảng lương
        </a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm h-100"><div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <div class="text-muted small">Tổng quỹ lương tháng</div>
                <div class="fs-4 fw-bold">@Model.TongQuyLuong.ToString("N0", vi) đ</div>
                <div class="text-muted small">Đã bao gồm thưởng và phạt</div>
            </div>
            <i class="bi bi-currency-dollar fs-2 text-primary"></i>
        </div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm h-100"><div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <div class="text-muted small">Nhân viên đang làm</div>
                <div class="fs-4 fw-bold">@Model.SoNhanVienDangLam NV</div>
                <div class="text-muted small">Kỳ @Model.Ky</div>
            </div>
            <i class="bi bi-people fs-2 text-purple" style="color:#7c4dff"></i>
        </div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm h-100"><div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <div class="text-muted small">Đã chốt lương</div>
                <div class="fs-4 fw-bold text-success">@Model.SoBanGhi NV</div>
                <div class="text-muted small">@Model.SoBanGhi / @Model.SoNhanVienDangLam nhân viên</div>
            </div>
            <i class="bi bi-check2-square fs-2 text-success"></i>
        </div></div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm h-100"><div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <div class="text-muted small">Chưa chốt</div>
                <div class="fs-4 fw-bold text-danger">@Model.SoChuaChot NV</div>
                <div class="text-muted small">Cần chốt trước khi kết thúc kỳ</div>
            </div>
            <i class="bi bi-clock-history fs-2 text-danger"></i>
        </div></div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light fw-semibold"><i class="bi bi-funnel me-2"></i>Bộ lọc &amp; Điều khiển tính lương</div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">Kỳ lương <span class="text-danger">(*)</span></label>
                <input type="month" name="ky" value="@Model.Ky" class="form-control" required />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">Trạng thái kỳ</label>
                <div><span class="badge @trangThai.Item2 fs-6">@trangThai.Item1</span></div>
            </div>
            <div class="col-12 col-md-4 d-flex gap-2">
                <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-repeat me-1"></i>Làm mới</a>
                <button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i>Lọc dữ liệu</button>
            </div>
        </form>
    </div>
</div>

<p class="text-muted small mt-3 mb-0">
    Công thức: <strong>Thực lĩnh = Lương cơ bản + Thưởng − Phạt</strong>
</p>