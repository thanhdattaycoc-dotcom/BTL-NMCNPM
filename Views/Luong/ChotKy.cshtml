azor
@model NMCNPM.Controllers.ChotKyViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Chốt kỳ lương";
    ViewData["Crumb"] = "Chốt kỳ lương";
    var vi = new CultureInfo("vi-VN");
    var inv = CultureInfo.InvariantCulture;
    string N(decimal v) => v.ToString("N0", vi);
}

<h4 class="text-primary mb-3"><i class="bi bi-check-circle me-2"></i>Chốt kỳ lương</h4>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" asp-action="ChotKy" class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">Kỳ lương <span class="text-danger">(*)</span></label>
                <input type="month" name="ky" value="@Model.Ky" class="form-control" required />
            </div>
            <div class="col-12 col-md-4">
                <button type="submit" class="btn btn-primary">Tải danh sách</button>
            </div>
        </form>
    </div>
</div>

<form method="post" asp-action="ChotKy" id="formChot">
    <input type="hidden" name="Ky" value="@Model.Ky" />

    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <div class="card shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Danh sách nhân viên kỳ @Model.Ky</span>
            <span class="small text-muted">Tick chọn nhân viên cần chốt. Nhân viên đã chốt bị khóa.</span>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center" style="width:40px"><input type="checkbox" id="chkAll" checked /></th>
                        <th>STT</th><th>Mã NV</th><th>Họ và tên</th>
                        <th class="text-end">Số giờ làm</th><th class="text-end">Lương cơ bản</th>
                        <th style="width:150px">Thưởng</th><th style="width:150px">Phạt</th>
                        <th class="text-end">Thực lĩnh</th><th class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="10" class="text-center text-muted py-4">Chưa có dữ liệu</td></tr>
                }
                @for (var i = 0; i < Model.Rows.Count; i++)
                {
                    var r = Model.Rows[i];
                    <tr data-lcb="@r.LuongCoBan.ToString("0.##", inv)" class="@(r.DaChot ? "table-light" : "")">
                        <td class="text-center">
                            <input type="hidden" name="Rows[@i].MaNV" value="@r.MaNV" />
                            @if (r.DaChot)
                            {
                                <input type="hidden" name="Rows[@i].Chon" value="false" />
                                <i class="bi bi-lock-fill text-secondary"></i>
                            }
                            else
                            {
                                <input type="checkbox" class="chk-row" name="Rows[@i].Chon" value="true" @(r.Chon ? "checked" : "") />
                                <input type="hidden" name="Rows[@i].Chon" value="false" />
                            }
                        </td>
                        <td>@(i + 1)</td>
                        <td>@r.MaNV</td>
                        <td>@r.TenNV</td>
                        <td class="text-end">@r.SoGioLam</td>
                        <td class="text-end">@N(r.LuongCoBan)</td>
                        <td>
                            @if (r.DaChot) { <span class="d-block text-end">@N(r.Thuong)</span> }
                            else { <input type="number" min="0" step="1000" class="form-control form-control-sm inp-thuong" name="Rows[@i].Thuong" value="@r.Thuong.ToString("0.##", inv)" /> }
                        </td>
                        <td>
                            @if (r.DaChot) { <span class="d-block text-end text-danger">@N(r.Phat)</span> }
                            else { <input type="number" min="0" step="1000" class="form-control form-control-sm inp-phat" name="Rows[@i].Phat" value="@r.Phat.ToString("0.##", inv)" /> }
                        </td>
                        <td class="text-end fw-bold col-thuclinh">@N(r.ThucLinh)</td>
                        <td class="text-center">
                            @if (r.DaChot)
                            {
                                <a class="badge bg-success text-decoration-none" asp-action="DieuChinh" asp-route-id="@r.MaLuong" title="Điều chỉnh thưởng/phạt">Đã chốt</a>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Chưa chốt</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="8">Tổng thực lĩnh các dòng được chọn (<span id="soChon">0</span> NV)</td>
                        <td class="text-end" id="tongChon">0</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="card-footer d-flex justify-content-end gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-ky="@Model.Ky">Quay lại</a>
            <button type="submit" class="btn btn-warning text-white"><i class="bi bi-check-circle me-1"></i>Chốt kỳ lương</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var rows = document.querySelectorAll('tbody tr[data-lcb]');
            var chkAll = document.getElementById('chkAll');
            function fmt(n) { return n.toLocaleString('vi-VN'); }

            function tinh() {
                var tong = 0, dem = 0;
                rows.forEach(function (tr) {
                    var th = tr.querySelector('.inp-thuong'), ph = tr.querySelector('.inp-phat');
                    if (!th) return;                                   // dòng đã chốt: giữ nguyên
                    var tl = parseFloat(tr.dataset.lcb) + (parseFloat(th.value) || 0) - (parseFloat(ph.value) || 0);
                    tr.querySelector('.col-thuclinh').textContent = fmt(tl);
                    tr.querySelector('.col-thuclinh').classList.toggle('text-danger', tl < 0);
                    var c = tr.querySelector('.chk-row');
                    if (c && c.checked) { tong += tl; dem++; }
                });
                document.getElementById('tongChon').textContent = fmt(tong);
                document.getElementById('soChon').textContent = dem;
            }

            chkAll.addEventListener('change', function () {
                document.querySelectorAll('.chk-row').forEach(function (c) { c.checked = chkAll.checked; });
                tinh();
            });
            document.querySelectorAll('.chk-row, .inp-thuong, .inp-phat').forEach(function (el) {
                el.addEventListener('input', tinh);
                el.addEventListener('change', tinh);
            });

            document.getElementById('formChot').addEventListener('submit', function (e) {
                var n = document.querySelectorAll('.chk-row:checked').length;
                if (!confirm('Chốt lương kỳ @Model.Ky cho ' + n + ' nhân viên? Sau khi chốt sẽ không tính lại được.')) {
                    e.preventDefault();
                }
            });
            tinh();
        })();
    </script>
}