azor
@model NMCNPM.Controllers.BangLuongViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Xem bảng lương";
    ViewData["Crumb"] = "Xem bảng lương";
    var vi = new CultureInfo("vi-VN");
    string N(decimal v) => v.ToString("N0", vi);
}

<h4 class="text-primary mb-3">Xem bảng lương</h4>

@if (TempData["ThongBao"] is string tb)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@tb
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@Model.ThongBaoLoi</div>
}

<div class="card shadow-sm">
    <div class="card-header bg-light text-center fw-semibold text-primary">Bảng lương nhân viên</div>
    <div class="card-body">
        <form method="get" asp-action="BangLuong" class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">Kỳ lương <span class="text-danger">(*)</span></label>
                <input type="month" name="ky" value="@Model.Ky" class="form-control" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">Phòng ban</label>
                <select name="phongBan" class="form-select">
                    <option value="">Tất cả phòng ban</option>
                    @foreach (var pb in Model.DanhSachPhongBan)
                    {
                        <option value="@pb" selected="@(pb == Model.PhongBan)">@pb</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">Mã / Tên nhân viên</label>
                <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control" />
            </div>
            <div class="col-12 d-flex justify-content-center gap-2">
                <button type="submit" class="btn btn-primary px-5">Xem</button>
                <a asp-action="BangLuong" class="btn btn-outline-primary px-5">Làm mới</a>
            </div>
        </form>

        @if (string.IsNullOrEmpty(Model.ThongBaoLoi))
        {
            <div class="table-responsive mt-4">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>STT</th><th>Mã NV</th><th>Họ và tên</th><th>Phòng ban</th>
                            <th class="text-end">Lương cơ bản</th><th class="text-end">Số giờ làm</th>
                            <th class="text-end">Thưởng</th><th class="text-end">Phạt</th>
                            <th class="text-end">Thực nhận</th><th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Dong.Count == 0)
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">Chưa có dữ liệu</td></tr>
                    }
                    else
                    {
                        var stt = 0;
                        foreach (var d in Model.Dong)
                        {
                            stt++;
                            <tr>
                                <td>@stt</td>
                                <td>@d.MaNV</td>
                                <td>@d.TenNV</td>
                                <td>@d.MaPB</td>
                                <td class="text-end">@N(d.LuongCoBan)</td>
                                <td class="text-end">@d.SoGioLam</td>
                                <td class="text-end">@N(d.Thuong)</td>
                                <td class="text-end @(d.Phat > 0 ? "text-danger" : "")">@N(d.Phat)</td>
                                <td class="text-end fw-bold">@N(d.ThucLinh)</td>
                                <td class="text-center">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="DieuChinh" asp-route-id="@d.SMaLuong" title="Điều chỉnh thưởng/phạt">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                    @if (Model.Dong.Count > 0)
                    {
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="4">Tổng cộng</td>
                                <td class="text-end">@N(Model.Dong.Sum(x => x.LuongCoBan))</td>
                                <td class="text-end">@Model.Dong.Sum(x => x.SoGioLam)</td>
                                <td class="text-end">@N(Model.Dong.Sum(x => x.Thuong))</td>
                                <td class="text-end text-danger">@N(Model.Dong.Sum(x => x.Phat))</td>
                                <td class="text-end">@N(Model.TongThucLinh)</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
            <div class="small text-muted mt-2">
                Đơn vị tính: VND. Thực nhận = Lương cơ bản + Thưởng − Phạt
            </div>
        }
    </div>
</div>