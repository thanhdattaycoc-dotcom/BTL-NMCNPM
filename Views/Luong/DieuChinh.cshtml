azor
@model NMCNPM.Controllers.DieuChinhViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Điều chỉnh lương";
    ViewData["Crumb"] = "Điều chỉnh lương";
    var vi = new CultureInfo("vi-VN");
    var inv = CultureInfo.InvariantCulture;
}

<h4 class="text-primary mb-3"><i class="bi bi-pencil-square me-2"></i>Điều chỉnh thưởng / phạt</h4>

<div class="row g-3">
    <div class="col-12 col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-light fw-semibold">
                Nhân viên @Model.MaNV - @Model.TenNV (kỳ @Model.Ky)
            </div>
            <div class="card-body">
                <form method="post" asp-action="DieuChinh" id="formDieuChinh">
                    <input type="hidden" name="sMaLuong" value="@Model.SMaLuong" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Lương cơ bản</label>
                            <input class="form-control" value="@Model.LuongCoBan.ToString("N0", vi) đ" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số giờ làm</label>
                            <input class="form-control" value="@Model.SoGioLam" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thưởng (đ)</label>
                            <input type="number" min="0" step="1000" name="thuong" id="thuong"
                                   value="@Model.Thuong.ToString("0.##", inv)" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phạt (đ)</label>
                            <input type="number" min="0" step="1000" name="phat" id="phat"
                                   value="@Model.Phat.ToString("0.##", inv)" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Thực lĩnh (tự tính)</label>
                            <input class="form-control fw-bold text-success fs-5" id="thucLinh" readonly />
                            <div id="canhBao" class="text-danger small mt-1" style="display:none">
                                Phạt vượt quá Lương cơ bản + Thưởng.
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a class="btn btn-outline-secondary" asp-action="BangLuong" asp-route-ky="@Model.Ky">Quay lại</a>
                        <button type="submit" class="btn btn-primary" id="btnLuu"><i class="bi bi-save me-1"></i>Lưu điều chỉnh</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var lcb = @Model.LuongCoBan.ToString("0.##", inv);
            var t = document.getElementById('thuong'), p = document.getElementById('phat');
            var out = document.getElementById('thucLinh'), warn = document.getElementById('canhBao');
            var btn = document.getElementById('btnLuu');
            function tinh() {
                var th = parseFloat(t.value) || 0, ph = parseFloat(p.value) || 0;
                var tl = lcb + th - ph;
                out.value = tl.toLocaleString('vi-VN') + ' đ';
                var loi = th < 0 || ph < 0 || tl < 0;
                warn.style.display = tl < 0 ? '' : 'none';
                btn.disabled = loi;
            }
            t.addEventListener('input', tinh);
            p.addEventListener('input', tinh);
            tinh();
        })();
    </script>
}