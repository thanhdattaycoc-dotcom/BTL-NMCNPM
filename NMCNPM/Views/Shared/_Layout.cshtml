@{
    var tenNguoiDung = Session["HoTen"] != null
        ? Session["HoTen"].ToString()
        : "Người dùng";

    var tenQuyen = Session["TenQuyen"] != null
        ? Session["TenQuyen"].ToString()
        : "";

    var maQuyen = Session["MaQuyen"] != null
        ? Session["MaQuyen"].ToString()
        : "";

    var daDangNhap = Session["MaTK"] != null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - TOCOTOCO HRM</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
        }

        /* SIDEBAR */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            height: 100vh;
            background: #1565c0;
            color: white;
            overflow-y: auto;
            z-index: 1000;
        }

        .sidebar-brand {
            padding: 25px 15px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.2);
        }

            .sidebar-brand h4 {
                font-weight: bold;
                margin: 10px 0 5px;
            }

            .sidebar-brand p {
                font-size: 12px;
                margin: 0;
                color: #dceaff;
            }

        .sidebar-menu {
            padding: 15px 10px;
        }

        .menu-title {
            padding: 12px 12px 6px;
            color: #bbd8ff;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            margin-bottom: 5px;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-size: 14px;
            transition: 0.2s;
        }

            .sidebar-menu a:hover {
                background: #0d47a1;
            }

            .sidebar-menu a.active {
                background: #0d47a1;
                font-weight: bold;
            }

        .sidebar-menu i {
            font-size: 17px;
            width: 20px;
        }

        /* MAIN */
        .main {
            margin-left: 250px;
            min-height: 100vh;
        }

        /* TOPBAR */
        .topbar {
            height: 70px;
            background: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 30px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

            .topbar h5 {
                margin: 0;
                color: #263238;
                font-weight: bold;
            }

        .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #1565c0;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .user-name {
            font-size: 14px;
            font-weight: bold;
            color: #263238;
        }

        .user-role {
            font-size: 12px;
            color: #78909c;
        }

        /* CONTENT */
        .content {
            padding: 25px 30px;
        }

        .content-inner {
            background: white;
            padding: 25px;
            border-radius: 10px;
            min-height: calc(100vh - 120px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }

        /* FOOTER */
        .footer {
            text-align: center;
            padding: 15px;
            color: #78909c;
            font-size: 12px;
        }

        .logout-link {
            color: #dc3545 !important;
        }

            .logout-link:hover {
                background: #fff0f0 !important;
            }

        @@media (max-width: 768px) {
            .sidebar {
                width: 70px;
            }

            .sidebar-brand h4,
            .sidebar-brand p,
            .sidebar-menu span,
            .menu-title {
                display: none;
            }

            .sidebar-menu a {
                justify-content: center;
                padding: 14px 5px;
            }

            .sidebar-menu i {
                font-size: 20px;
            }

            .main {
                margin-left: 70px;
            }

            .topbar {
                padding: 0 15px;
            }

            .content {
                padding: 15px;
            }
        }
    </style>
</head>

<body>

    @if (daDangNhap)
    {
        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="sidebar-brand">
                <i class="bi bi-cup-hot-fill" style="font-size:35px;"></i>
                <h4>TOCOTOCO</h4>
                <p>HỆ THỐNG QUẢN LÝ NHÂN SỰ</p>
            </div>

            <nav class="sidebar-menu">

                <div class="menu-title">Tổng quan</div>

                <a href="@Url.Action("Index", "Home")">
                    <i class="bi bi-speedometer2"></i>
                    <span>Trang chủ</span>
                </a>

                <div class="menu-title">Quản lý nhân sự</div>

                <a href="@Url.Action("Index", "NhanVien")">
                    <i class="bi bi-people"></i>
                    <span>Quản lý nhân viên</span>
                </a>

                <a href="@Url.Action("Index", "PhongBan")">
                    <i class="bi bi-building"></i>
                    <span>Phòng ban</span>
                </a>

                <a href="@Url.Action("Index", "ChucVu")">
                    <i class="bi bi-person-badge"></i>
                    <span>Chức vụ</span>
                </a>

                <div class="menu-title">Quản lý công việc</div>


                @*<a href="@Url.Action("Index", "ChamCong")">
            <i class="bi bi-calendar-check"></i>
            <span>Chấm công</span>
        </a>*@




                <div>
                    <!-- Menu chính Chấm công (Chữ trắng, viết đậm) -->
                    <a href="@Url.Action("Index", "ChamCong")" class="text-white text-decoration-none fw-bold">
                        <i class="bi bi-calendar-check text-white"></i>
                        <span>Chấm công</span>
                    </a>

                    <!-- 3 Chức năng con hiện sẵn bên dưới (Chữ trắng) -->
                    <ul class="list-unstyled ms-4 mt-1">
                        <li class="mb-1">
                            <a href="@Url.Action("TrucTuyen", "ChamCong")" class="text-white text-decoration-none">
                                <i class="bi bi-arrow-right-short text-white"></i> Chấm công hàng ngày
                            </a>
                        </li>
                        <li class="mb-1">
                            <a href="@Url.Action("LichSu", "ChamCong")" class="text-white text-decoration-none">
                                <i class="bi bi-arrow-right-short text-white"></i> Lịch sử chấm công
                            </a>
                        </li>
                        <li class="mb-1">
                            <a href="@Url.Action("TheoDoi", "ChamCong")" class="text-white text-decoration-none">
                                <i class="bi bi-arrow-right-short text-white"></i> Theo dõi chấm công
                            </a>
                        </li>
                    </ul>
                </div>










                <a href="@Url.Action("Index", "Luong")">
                    <i class="bi bi-cash-stack"></i>
                    <span>Quản lý lương</span>
                </a>

                <a href="@Url.Action("Index", "HopDong")">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Hợp đồng lao động</span>
                </a>

                <a href="@Url.Action("Index", "DonTu")">
                    <i class="bi bi-envelope-paper"></i>
                    <span>Đơn từ</span>
                </a>

                @if (maQuyen == "Q_ADMIN")
                {
                    <div class="menu-title">Hệ thống</div>

                    <a href="@Url.Action("Register", "TaiKhoan")">
                        <i class="bi bi-person-plus"></i>
                        <span>Tạo tài khoản</span>
                    </a>
                }

                <div class="menu-title">Tài khoản</div>

                <a href="@Url.Action("DoiMatKhau", "TaiKhoan")">
                    <i class="bi bi-key"></i>
                    <span>Đổi mật khẩu</span>
                </a>

                <a href="@Url.Action("Logout", "TaiKhoan")"
                   class="logout-link"
                   onclick="return confirm('Bạn có chắc chắn muốn đăng xuất?');">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Đăng xuất</span>
                </a>

            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main">

            <header class="topbar">
                <h5>@ViewBag.Title</h5>

                <div class="user-info">
                    <div class="user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div>
                        <div class="user-name">@tenNguoiDung</div>
                        <div class="user-role">@tenQuyen</div>
                    </div>
                </div>
            </header>

            <section class="content">
                <div class="content-inner">
                    @RenderBody()
                </div>
            </section>

            <footer class="footer">
                © @DateTime.Now.Year TOCOTOCO HRM - Hệ thống quản lý nhân sự
            </footer>

        </main>
    }
    else
    {
        <!-- TRANG CHƯA ĐĂNG NHẬP -->
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)

</body>
</html>
