                </tr>

                <tr>
                    <td>3</td>
                    <td>Kiểm tra bảng chấm công</td>
                    <td>Admin</td>
                    <td>03/11/2026</td>
                    <td><span class="status success">Hoàn thành</span></td>
                </tr>

                <tr>
                    <td>4</td>
                    <td>Cập nhật phòng ban</td>
                    <td>Admin</td>
                    <td>03/11/2026</td>
                    <td><span class="status success">Hoàn thành</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
