@model NMCNPM.Models.LoginViewModel

@{
    ViewBag.Title = "Đăng nhập hệ thống";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Đăng nhập - Tocotoco HRM</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial;
            background: linear-gradient(135deg, #7e1729, #d84b5d);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-box {
            width: 400px;
            background: white;
            padding: 35px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,.2);
        }

        .logo {
            text-align: center;
            color: #b92f3e;
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;
            color: #777;
            margin-bottom: 25px;
        }

        .form-control {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 7px;
            margin: 8px 0 18px;
            outline: none;
        }

            .form-control:focus {
                border-color: #b92f3e;
            }

        .btn-login {
            width: 100%;
            background: #b92f3e;
            color: white;
            border: none;
            padding: 13px;
            border-radius: 7px;
            font-size: 16px;
            cursor: pointer;
        }

            .btn-login:hover {
                background: #922331;
            }

        .error {
            color: red;
            margin-bottom: 15px;
            font-size: 13px;
        }

        .remember {
            margin-bottom: 18px;
            font-size: 14px;
        }
    </style>
</head>

<body>

    <div class="login-box">

        <div class="logo">TOCOTOCO HRM</div>

        <div class="subtitle">
            HỆ THỐNG QUẢN LÝ NHÂN SỰ
        </div>

        @using (Html.BeginForm("Login", "TaiKhoan",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true, "", new { @class = "error" })

            <label>Tên đăng nhập</label>

            @Html.TextBoxFor(m => m.TenDangNhap,
                new
                     {
                    @class = "form-control",
                    placeholder = "Nhập tên đăng nhập"
                })

            @Html.ValidationMessageFor(
                m => m.TenDangNhap, "",
                new { @class = "error" })

            <label>Mật khẩu</label>

            @Html.PasswordFor(m => m.MatKhau,
                new
                     {
                    @class = "form-control",
                    placeholder = "Nhập mật khẩu"
                })

            @Html.ValidationMessageFor(
                m => m.MatKhau, "",
                new { @class = "error" })

            <div class="remember">
                @Html.CheckBoxFor(m => m.GhiNho)
                Ghi nhớ đăng nhập
            </div>

            <button type="submit" class="btn-login">
                ĐĂNG NHẬP
            </button>
        }

    </div>

</body>
</html>