@model NMCNPM.Models.DoiMatKhauViewModel

@{
    ViewBag.Title = "Đổi mật khẩu";
}

<style>
    .password-box {
        max-width: 500px;
        margin: 50px auto;
        padding: 30px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 3px 15px rgba(0,0,0,.1);
    }

        .password-box h2 {
            color: #b92f3e;
            text-align: center;
            margin-bottom: 25px;
        }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        margin: 8px 0 15px;
    }

    .btn-save {
        width: 100%;
        padding: 12px;
        border: none;
        background: #b92f3e;
        color: white;
        border-radius: 6px;
        cursor: pointer;
    }

    .error {
        color: red;
        font-size: 13px;
    }
</style>

<div class="password-box">

    <h2>ĐỔI MẬT KHẨU</h2>

    @using (Html.BeginForm("DoiMatKhau",
        "TaiKhoan", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "",
            new { @class = "error" })

        <label>Mật khẩu hiện tại</label>

        @Html.PasswordFor(m => m.MatKhauCu,
            new { @class = "form-control" })

        @Html.ValidationMessageFor(
            m => m.MatKhauCu, "",
            new { @class = "error" })

        <label>Mật khẩu mới</label>

        @Html.PasswordFor(m => m.MatKhauMoi,
            new { @class = "form-control" })

        @Html.ValidationMessageFor(
            m => m.MatKhauMoi, "",
            new { @class = "error" })

        <label>Xác nhận mật khẩu mới</label>

        @Html.PasswordFor(m => m.XacNhanMatKhau,
            new { @class = "form-control" })

        @Html.ValidationMessageFor(
            m => m.XacNhanMatKhau, "",
            new { @class = "error" })

        <button type="submit" class="btn-save">
            CẬP NHẬT MẬT KHẨU
        </button>
    }

</div>