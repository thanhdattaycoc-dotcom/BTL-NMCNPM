
@model NMCNPM.Models.RegisterViewModel

@{
    Layout = null;
    ViewBag.Title = "Đăng ký Admin";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng ký Admin - TOCOTOCO HRM</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #eaf2fb;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial;
        }

        .register-box {
            width: 440px;
            max-width: 95%;
            background: white;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,.12);
        }

        .register-title {
            color: #1565c0;
            text-align: center;
            font-weight: bold;
        }

        .btn-register {
            width: 100%;
            background: #1565c0;
            color: white;
            padding: 11px;
            font-weight: bold;
        }

            .btn-register:hover {
                background: #0d47a1;
                color: white;
            }
    </style>
</head>

<body>
    <div class="register-box">
        <h3 class="register-title">TOCOTOCO HRM</h3>
        <p class="text-center text-muted mb-4">
            ĐĂNG KÝ TÀI KHOẢN QUẢN TRỊ ĐẦU TIÊN
        </p>

        @using (Html.BeginForm("Register", "TaiKhoan", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(false, "", new { @class = "text-danger" })

            <div class="mb-3">
                <label class="form-label">Mã nhân viên</label>
                @Html.TextBoxFor(m => m.MaNV,
                    new { @class = "form-control", placeholder = "Nhập mã nhân viên" })
                @Html.ValidationMessageFor(m => m.MaNV, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label">Tên đăng nhập</label>
                @Html.TextBoxFor(m => m.TenDangNhap,
                    new { @class = "form-control", placeholder = "Nhập tên đăng nhập" })
                @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label">Mật khẩu</label>
                @Html.PasswordFor(m => m.MatKhau,
                    new { @class = "form-control", placeholder = "Nhập mật khẩu" })
                @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label">Xác nhận mật khẩu</label>
                @Html.PasswordFor(m => m.XacNhanMatKhau,
                    new { @class = "form-control", placeholder = "Nhập lại mật khẩu" })
                @Html.ValidationMessageFor(m => m.XacNhanMatKhau, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-register">
                TẠO TÀI KHOẢN ADMIN
            </button>
        }
    </div>
</body>
</html>
