
@using System.Linq
@model NMCNPM.Models.LichSuViewModel

@{
    ViewBag.Title = "Lịch sử chấm công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .attendance-header {
        margin-bottom: 22px;
    }

        .attendance-header h2 {
            color: #0860aa;
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .attendance-header p {
            color: #8291a3;
            font-size: 13px;
            margin: 0;
        }

    /* BỘ LỌC */
    .filter-card,
    .result-card {
        background: #fff;
        border: 1px solid #dbe4ee;
        border-radius: 10px;
        margin-bottom: 22px;
        overflow: hidden;
        box-shadow: 0 2px 7px rgba(0,0,0,.03);
    }

    .section-title {
        background: #eaf2ff;
        padding: 13px 20px;
        color: #0d3b66;
        font-size: 15px;
        font-weight: bold;
    }

    .filter-body {
        padding: 18px 20px;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: 1.2fr 1.2fr 1.2fr auto auto;
        gap: 12px;
        align-items: end;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
        min-width: 0;
    }

        .filter-group label {
            font-size: 13px;
            font-weight: 600;
            color: #334155;
        }

    .filter-control {
        width: 100%;
        height: 40px;
        padding: 8px 10px;
        border: 1px solid #dbe4ee;
        border-radius: 8px;
        font-size: 13px;
        outline: none;
        background: #fff;
        color: #1e293b;
        box-sizing: border-box;
    }

        .filter-control:focus {
            border-color: #1877f2;
            box-shadow: 0 0 0 3px rgba(24,119,242,.12);
        }

    .report-button {
        height: 40px;
        padding: 0 17px;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        white-space: nowrap;
        box-sizing: border-box;
    }

    .btn-search {
        background: #1877f2;
        color: #fff;
    }

    .btn-reset {
        background: #fff;
        border: 1px solid #dbe4ee;
        color: #475569;
    }

    /* THỐNG KÊ */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 22px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #dbe4ee;
        border-radius: 10px;
        padding: 18px 15px;
        box-shadow: 0 2px 7px rgba(0,0,0,.03);
        min-width: 0;
    }

    .stat-label {
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 12px;
        min-height: 32px;
    }

    .stat-value {
        color: #0d3b66;
        font-size: 25px;
        font-weight: bold;
        line-height: 1.2;
    }

    .stat-unit {
        font-size: 12px;
        color: #8291a3;
        margin-left: 3px;
    }

    .stat-work {
        border-top: 3px solid #1877f2;
    }

    .stat-late {
        border-top: 3px solid #f59e0b;
    }

    .stat-early {
        border-top: 3px solid #8b5cf6;
    }

    .stat-absent {
        border-top: 3px solid #ef4444;
    }

    .stat-hours {
        border-top: 3px solid #10b981;
    }

    /* BẢNG KẾT QUẢ */
    .result-header {
        padding: 16px 20px;
        color: #0d3b66;
        font-weight: bold;
        font-size: 15px;
        border-bottom: 1px solid #dbe4ee;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .attendance-table {
        width: 100%;
        min-width: 750px;
        border-collapse: collapse;
        text-align: center;
    }

        .attendance-table th {
            background: #0d3b66;
            color: #fff;
            padding: 13px 10px;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
        }

        .attendance-table td {
            padding: 13px 10px;
            border-bottom: 1px solid #dbe4ee;
            font-size: 13px;
        }

        .attendance-table tbody tr:nth-child(even) {
            background: #f8fafc;
        }

        .attendance-table tbody tr:hover {
            background: #eef6ff;
        }

    .status-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-complete {
        background: #d9f4e2;
        color: #168348;
    }

    .status-working {
        background: #e1efff;
        color: #0874df;
    }

    .status-warning {
        background: #fff2d5;
        color: #b7791f;
    }

    .status-danger {
        background: #fee2e2;
        color: #b91c1c;
    }

    .empty-message {
        padding: 25px !important;
        color: #8291a3;
        text-align: center;
    }

    .table-footer {
        display: flex;
        justify-content: flex-end;
        padding: 12px 16px;
        font-size: 12px;
        color: #64748b;
        border-top: 1px solid #dbe4ee;
    }

    @@media (max-width: 1100px) {
        .stats-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .filter-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .filter-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .filter-body {
            padding: 15px;
        }

        .report-button {
            width: 100%;
        }
    }

    @@media (max-width: 400px) {
        .filter-grid,
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- TIÊU ĐỀ -->
<div class="attendance-header">
    <h2>Lịch sử chấm công</h2>
    <p>Theo dõi lịch sử và thống kê chấm công cá nhân</p>
</div>

<!-- BỘ LỌC -->
<div class="filter-card">

    <div class="section-title">
        Tìm kiếm lịch sử chấm công
    </div>

    <div class="filter-body">

        @using (Html.BeginForm("LichSu", "ChamCong", FormMethod.Get))
        {
            <div class="filter-grid">

                <div class="filter-group">
                    <label>Từ ngày</label>
                    <input type="date"
                           name="TuNgay"
                           class="filter-control"
                           value="@(Model.TuNgay.HasValue
                               ? Model.TuNgay.Value.ToString("yyyy-MM-dd")
                               : "")" />
                </div>

                <div class="filter-group">
                    <label>Đến ngày</label>
                    <input type="date"
                           name="DenNgay"
                           class="filter-control"
                           value="@(Model.DenNgay.HasValue
                               ? Model.DenNgay.Value.ToString("yyyy-MM-dd")
                               : "")" />
                </div>

                <div class="filter-group">
                    <label>Trạng thái</label>

                    <select name="TrangThai" class="filter-control">
                        <option value="">Tất cả trạng thái</option>

                        <option value="Đang làm việc"
                                @(Model.TrangThai == "Đang làm việc" ? "selected" : "")>
                            Đang làm việc
                        </option>

                        <option value="Đã hoàn thành"
                                @(Model.TrangThai == "Đã hoàn thành" ? "selected" : "")>
                            Đã hoàn thành
                        </option>

                        <option value="Đi muộn"
                                @(Model.TrangThai == "Đi muộn" ? "selected" : "")>
                            Đi muộn
                        </option>

                        <option value="Vắng mặt"
                                @(Model.TrangThai == "Vắng mặt" ? "selected" : "")>
                            Vắng mặt
                        </option>
                    </select>
                </div>

                <button type="submit"
                        class="report-button btn-search">
                    <i class="bi bi-search"></i>
                    Tìm kiếm
                </button>

                <a href="@Url.Action("LichSu", "ChamCong")"
                   class="report-button btn-reset">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Làm mới
                </a>

            </div>
        }

    </div>
</div>

<!-- 5 THẺ THỐNG KÊ -->
<div class="stats-grid">

    <div class="stat-card stat-work">
        <div class="stat-label">Số ngày công</div>
        <div class="stat-value">
            @Model.SoNgayCong
            <span class="stat-unit">ngày</span>
        </div>
    </div>

    <div class="stat-card stat-late">
        <div class="stat-label">Số ngày đi muộn</div>
        <div class="stat-value">
            @Model.SoNgayMuon
            <span class="stat-unit">ngày</span>
        </div>
    </div>

    <div class="stat-card stat-early">
        <div class="stat-label">Số ngày về sớm</div>
        <div class="stat-value">
            @Model.SoNgayVeSom
            <span class="stat-unit">ngày</span>
        </div>
    </div>

    <div class="stat-card stat-absent">
        <div class="stat-label">Số ngày nghỉ</div>
        <div class="stat-value">
            @Model.SoNgayNghi
            <span class="stat-unit">ngày</span>
        </div>
    </div>

    <div class="stat-card stat-hours">
        <div class="stat-label">Tổng số giờ làm</div>
        <div class="stat-value">
            @Model.TongSoGioLam
            <span class="stat-unit">giờ</span>
        </div>
    </div>

</div>

<!-- BẢNG LỊCH SỬ -->
<div class="result-card">

    <div class="result-header">
        <i class="bi bi-calendar-check"></i>
        Chi tiết lịch sử chấm công
    </div>

    <div class="table-responsive">

        <table class="attendance-table">

            <thead>
                <tr>
                    <th>STT</th>
                    <th>Ngày chấm công</th>
                    <th>Giờ vào</th>
                    <th>Giờ ra</th>
                    <th>Số giờ làm</th>
                    <th>Trạng thái</th>
                    <th>Ghi chú</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.DanhSachChamCong != null
                    && Model.DanhSachChamCong.Any())
                {
                    int stt = 1;

                    foreach (var item in Model.DanhSachChamCong)
                    {
                        string badgeClass = "status-working";

                        if (item.TrangThai == "Đã hoàn thành")
                        {
                            badgeClass = "status-complete";
                        }
                        else if (item.TrangThai == "Đi muộn")
                        {
                            badgeClass = "status-warning";
                        }
                        else if (item.TrangThai == "Vắng mặt")
                        {
                            badgeClass = "status-danger";
                        }

                        <tr>
                            <td>@stt</td>

                            <td>
                                @item.NgayChamCong.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @(item.GioVao.HasValue
                                    ? item.GioVao.Value.ToString("HH:mm:ss")
                                    : "--")
                            </td>

                            <td>
                                @(item.GioRa.HasValue
                                    ? item.GioRa.Value.ToString("HH:mm:ss")
                                    : "--")
                            </td>

                            <td>@item.SoGioLam giờ</td>

                            <td>
                                <span class="status-badge @badgeClass">
                                    @item.TrangThai
                                </span>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.GhiChu)
                                    ? "--"
                                    : item.GhiChu)
                            </td>
                        </tr>

                        stt++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="empty-message">
                            Không tìm thấy dữ liệu chấm công phù hợp.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div class="table-footer">
        Tổng số:
        @(Model.DanhSachChamCong == null
            ? 0
            : Model.DanhSachChamCong.Count)
        bản ghi
    </div>

</div>
