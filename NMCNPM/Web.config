<?xml version="1.0" encoding="utf-8"?>

<configuration>

	<!-- 1. KET NOI DATABASE -->
	<connectionStrings>
		<add name="HRMConnection"
			 connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=db_HRM_Tocotoco;Integrated Security=True;MultipleActiveResultSets=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<!-- 2. CAU HINH UNG DUNG -->
	<appSettings>
		<add key="webpages:Version" value="3.0.0.0" />
		<add key="webpages:Enabled" value="false" />
		<add key="ClientValidationEnabled" value="true" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />
	</appSettings>

	<!-- 3. CAU HINH ASP.NET MVC -->
	<system.web>

		<compilation debug="true" targetFramework="4.8" />

		<httpRuntime targetFramework="4.8"
					 maxRequestLength="10240"
					 executionTimeout="3600" />

		<!-- XAC THUC FORMS AUTHENTICATION -->
		<authentication mode="Forms">
			<forms loginUrl="~/TaiKhoan/Login"
				   timeout="30"
				   slidingExpiration="true"
				   protection="All"
				   cookieless="UseCookies"
				   requireSSL="false"
				   path="/" />
		</authentication>

		<!-- SESSION -->
		<sessionState mode="InProc"
					  timeout="30"
					  cookieless="UseCookies" />

		<!-- CAU HINH RAZOR -->
		<pages controlRenderingCompatibilityVersion="4.0">
			<namespaces>
				<add namespace="System.Web.Mvc" />
				<add namespace="System.Web.Mvc.Ajax" />
				<add namespace="System.Web.Mvc.Html" />
				<add namespace="System.Web.Routing" />
				<add namespace="NMCNPM" />
				<add namespace="NMCNPM.Models" />
			</namespaces>
		</pages>

		<!-- CUSTOM ERRORS -->
		<customErrors mode="RemoteOnly"
					  defaultRedirect="~/Home/Error" />

	</system.web>

	<!-- 4. CAU HINH IIS -->
	<system.webServer>

		<validation validateIntegratedModeConfiguration="false" />

		<modules runAllManagedModulesForAllRequests="true" />

		<handlers>
			<remove name="ExtensionlessUrlHandler-Integrated-4.0" />

			<add name="ExtensionlessUrlHandler-Integrated-4.0"
				 path="*."
				 verb="*"
				 type="System.Web.Handlers.TransferRequestHandler"
				 preCondition="integratedMode,runtimeVersionv4.0" />
		</handlers>

	</system.webServer>

	<!-- 5. BINDING REDIRECT -->
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">

			<dependentAssembly>
				<assemblyIdentity
				  name="System.Web.Mvc"
				  publicKeyToken="31bf3856ad364e35"
				  culture="neutral" />

				<bindingRedirect
				  oldVersion="0.0.0.0-5.2.9.0"
				  newVersion="5.2.9.0" />
			</dependentAssembly>

			<dependentAssembly>
				<assemblyIdentity
				  name="Microsoft.Web.Infrastructure"
				  publicKeyToken="31bf3856ad364e35"
				  culture="neutral" />

				<bindingRedirect
				  oldVersion="0.0.0.0-2.0.0.0"
				  newVersion="2.0.0.0" />
			</dependentAssembly>

			<dependentAssembly>
				<assemblyIdentity
				  name="System.Web.Razor"
				  publicKeyToken="31bf3856ad364e35"
				  culture="neutral" />

				<bindingRedirect
				  oldVersion="0.0.0.0-3.0.0.0"
				  newVersion="3.0.0.0" />
			</dependentAssembly>

			<dependentAssembly>
				<assemblyIdentity
				  name="System.Web.WebPages"
				  publicKeyToken="31bf3856ad364e35"
				  culture="neutral" />

				<bindingRedirect
				  oldVersion="0.0.0.0-3.0.0.0"
				  newVersion="3.0.0.0" />
			</dependentAssembly>

			<dependentAssembly>
				<assemblyIdentity
				  name="System.Web.WebPages.Razor"
				  publicKeyToken="31bf3856ad364e35"
				  culture="neutral" />

				<bindingRedirect
				  oldVersion="0.0.0.0-3.0.0.0"
				  newVersion="3.0.0.0" />
			</dependentAssembly>

		</assemblyBinding>
	</runtime>

</configuration>
